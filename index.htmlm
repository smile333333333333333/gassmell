<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GAS: THE TRUTH</title>

<style>

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #090b10;
    color: white;
    font-family: Arial, sans-serif;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: #10151d;
    cursor: crosshair;
}

#ui {
    position: fixed;
    left: 12px;
    top: 10px;
    z-index: 5;
    pointer-events: none;
    text-shadow: 2px 2px #000;
}

#title {
    font-size: 24px;
    font-weight: 900;
}

#stats {
    font-size: 17px;
    margin-top: 5px;
}

#help {
    position: fixed;
    right: 12px;
    top: 10px;
    text-align: right;
    font-size: 13px;
    color: #ddd;
    pointer-events: none;
}

#message {
    position: fixed;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    background: #111d;
    padding: 10px 16px;
    border: 2px solid white;
    border-radius: 8px;
    opacity: 0;
    transition: .2s;
    pointer-events: none;
    z-index: 10;
}

#start {
    position: fixed;
    inset: 0;
    background: #080a0eee;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
}

.panel {
    width: min(620px, calc(100% - 40px));
    padding: 30px;
    box-sizing: border-box;

    background: #151b25;

    border: 3px solid white;
    border-radius: 15px;

    text-align: center;

    box-shadow: 0 0 35px #000;
}

.panel h1 {
    font-size: 48px;
    margin: 0 0 10px;
}

.panel p {
    line-height: 1.5;
}

button {
    font-size: 20px;
    font-weight: bold;

    padding: 14px 26px;

    border: 0;
    border-radius: 8px;

    cursor: pointer;

    background: white;
    color: black;
}

button:hover {
    transform: scale(1.05);
}

button:active {
    transform: scale(.97);
}

.small {
    color: #bbb;
    font-size: 14px;
}

</style>
</head>

<body>

<canvas id="game"></canvas>

<div id="ui">

    <div id="title">
        💨 GAS: THE TRUTH
    </div>

    <div id="stats">
        Loading...
    </div>

</div>

<div id="help">

    WASD = MOVE<br>
    MOUSE = AIM<br>
    CLICK = FIRE<br>
    E = PICK UP / INTERACT<br>
    R = RELOAD

</div>

<div id="message"></div>

<div id="start">

    <div class="panel">

        <h1>
            💨 GAS: THE TRUTH
        </h1>

        <p>
            You discovered something BIG GAS
            doesn't want anyone to know.
        </p>

        <p>
            Search the facilities, collect evidence,
            pick up equipment, dodge incoming
            projectiles and survive the Gaslord.
        </p>

        <p class="small">
            Arcade-style fictional combat.
            Enemies disappear in cartoon effects
            rather than graphic injuries.
        </p>

        <button id="startButton">
            START INVESTIGATION
        </button>

    </div>

</div>

<!--
    IMPORTANT:
    game.js MUST be in the same folder as this file.
-->

<script src="./game.js"></script>

<script>

document.addEventListener("DOMContentLoaded", function() {

    const button =
        document.getElementById("startButton");

    if (!button) {
        console.error("START BUTTON NOT FOUND");
        return;
    }

    button.addEventListener("click", function() {

        console.log("START BUTTON CLICKED");

        if (typeof window.startGame === "function") {

            window.startGame();

        } else {

            alert(
                "game.js did not load correctly."
            );

        }

    });

});

</script>

</body>
</html>
